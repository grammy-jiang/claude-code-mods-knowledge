# Local tooling and credentials
.DS_Store
.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.coverage
.work/
dist/

# Snapshot collection process locks and incomplete atomic writes
sources/snapshots/.lock
sources/snapshots/**/.pending-*

# Claim lifecycle audit file lock and pending atomic replacements
decisions/.lock
decisions/.pending-*
claims/.pending-*
